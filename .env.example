# Deployment Configuration
REMOTE_HOST=your.server.com
REMOTE_USER=username
REMOTE_PATH=/var/www/biblio/

# OpenAlex Polite Pool
OPENALEX_EMAIL=your-email@example.com

# Relevance Filtering Engine ('ollama' or 'gemini')
# Local Ollama (llama3.1:8b) is recommended: fast (~20 min/day), free, private, handles high volume (1,300+ papers/day) without quota limits
RELEVANCE_ENGINE=ollama
OLLAMA_FILTER_MODEL=llama3.1:8b

# Synthesis Engine ('gemini-api', 'gemini-cli', or 'ollama')
# Remote Gemini API (gemini-2.5-flash) is recommended: 5-10s per paper, 1M context (no HTML/PDF timeouts)
# The free tier (20 requests/day) comfortably covers the 2-6 daily relevant papers at 0€ cost
SYNTHESIS_ENGINE=gemini-api
GEMINI_MODEL=gemini-2.5-flash

# Ollama Host & Models (for local processing or fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b

# Required if using gemini-api (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Budget Control (in Euro)
MAX_MONTHLY_COST=10.0

# Optional API Keys
# CORE API Key (https://core.ac.uk/services/api#form)
CORE_API_KEY=
# Elsevier API Key (https://dev.elsevier.com/)
ELSEVIER_API_KEY=
